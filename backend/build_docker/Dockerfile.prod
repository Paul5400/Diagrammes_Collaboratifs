# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Installation des outils nécessaires pour Prisma
RUN apk add --no-cache openssl

# Copie des fichiers de dépendances
COPY package*.json ./
COPY prisma ./prisma/

# Installation des dépendances (y compris les devDependencies pour le build)
RUN npm install

# Copie du code source
COPY . .

# Génération du client Prisma et build du projet
RUN npx prisma generate
RUN npm run build

# Stage 2: Runtime
FROM node:20-alpine AS runner

WORKDIR /app

# Installation de openssl pour Prisma
RUN apk add --no-cache openssl

# Copie des fichiers nécessaires depuis le builder
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/dist ./dist
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/prisma ./prisma

# Variable d'environnement pour la production
ENV NODE_ENV=production

# Exposition du port
EXPOSE 3001

# Commande de démarrage (on utilise node directement pour plus de légèreté)
CMD ["node", "dist/main"]
