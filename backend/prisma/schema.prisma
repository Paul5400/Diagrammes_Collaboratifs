// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ================================
// Modèle Utilisateur
// ================================
model Utilisateur {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @map("id_utilisateur") @db.Uuid
  nom             String   @db.VarChar(50)
  prenom          String   @db.VarChar(50)
  email           String   @unique @db.VarChar(100)
  motDePasse      String   @map("mot_de_passe") @db.VarChar(255)
  role            Role     @default(utilisateur)
  dateInscription DateTime @default(now()) @map("date_inscription") @db.Timestamp()

  @@map("utilisateurs")
}

// ================================
// Modèle Projet
// ================================
model Projet {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @map("id_projet") @db.Uuid
  idProprietaire   String   @map("id_proprietaire") @db.Uuid
  titre            String   @db.VarChar(150)
  description      String?  @db.Text
  cheminGit        String?  @unique @map("chemin_git") @db.VarChar(255)
  public           Boolean  @default(false)
  dateCreation     DateTime @default(now()) @map("date_creation") @db.Timestamp()
  dateModification DateTime @default(now()) @updatedAt @map("date_modification") @db.Timestamp()

  // Relations
  proprietaire   GithubUser      @relation("ProprietaireProjet", fields: [idProprietaire], references: [id], onDelete: Cascade)
  diagrammes     Diagramme[]     @relation("ProjetDiagrammes")
  collaborations Collaboration[] @relation("ProjetCollaborations")
  demandesAcces  DemandeAcces[]

  @@map("projets")
}

// ================================
// Modèle Diagramme
// ================================
model Diagramme {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @map("id_diagramme") @db.Uuid
  idProprietaire     String          @map("id_proprietaire") @db.Uuid
  idProjet           String          @map("id_projet") @db.Uuid
  titre              String          @db.VarChar(100)
  type               TypeDiagramme
  contenu            String?         @db.Text
  cheminGit          String?         @map("chemin_git") @db.VarChar(255)
  lienPartage        String          @unique @default(dbgenerated("gen_random_uuid()")) @map("lien_partage") @db.Uuid
  public             Boolean         @default(false)
  dateCreation       DateTime        @default(now()) @map("date_creation") @db.Timestamp()
  dateModification   DateTime        @default(now()) @updatedAt @map("date_modification") @db.Timestamp()
  
  // Relations
  proprietaire       GithubUser      @relation("ProprietaireDiagramme", fields: [idProprietaire], references: [id], onDelete: Cascade)
  projet             Projet          @relation("ProjetDiagrammes", fields: [idProjet], references: [id], onDelete: Cascade)
  collaborations     Collaboration[]

  @@map("diagrammes")
}

// ================================
// Modèle Collaboration
// ================================
model Collaboration {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id_collaboration") @db.Uuid
  idUtilisateur String   @map("id_utilisateur") @db.Uuid
  idProjet      String?  @map("id_projet") @db.Uuid
  idDiagramme   String?  @map("id_diagramme") @db.Uuid
  droit         Droit    @default(lecture)
  dateAjout     DateTime @default(now()) @map("date_ajout") @db.Timestamp()

  // Relations
  utilisateur GithubUser @relation("GithubUserCollaborations", fields: [idUtilisateur], references: [id], onDelete: Cascade)
  projet      Projet?    @relation("ProjetCollaborations", fields: [idProjet], references: [id], onDelete: Cascade)
  diagramme   Diagramme? @relation(fields: [idDiagramme], references: [id], onDelete: Cascade)

  @@unique([idUtilisateur, idProjet], name: "unique_utilisateur_projet")
  @@map("collaborations")
}

// ================================
// Enums
// ================================
enum Role {
  utilisateur
  admin
}

enum TypeDiagramme {
  uml
  sequence
  flux
  activite
  classe
  mermaid
  plantuml
  autre
}

enum Droit {
  lecture
  ecriture
}

enum StatutDemande {
  en_attente
  acceptee
  refusee
}

enum TypeNotification {
  demande_acces
  acces_accepte
  acces_refuse
  info
}

// ================================
// Modèle DemandeAcces
// ================================
model DemandeAcces {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @map("id_demande") @db.Uuid
  idUtilisateur String        @map("id_utilisateur") @db.Uuid
  idProjet      String        @map("id_projet") @db.Uuid
  statut        StatutDemande @default(en_attente)
  dateDemande   DateTime      @default(now()) @map("date_demande") @db.Timestamp()
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp()

  utilisateur GithubUser @relation("Demandeur", fields: [idUtilisateur], references: [id], onDelete: Cascade)
  projet      Projet     @relation(fields: [idProjet], references: [id], onDelete: Cascade)

  @@unique([idUtilisateur, idProjet])
  @@map("demandes_acces")
}

// ================================
// Modèle Notification
// ================================
model Notification {
  id            String           @id @default(dbgenerated("gen_random_uuid()")) @map("id_notification") @db.Uuid
  idUtilisateur String           @map("id_utilisateur") @db.Uuid
  type          TypeNotification
  message       String           @db.VarChar(255)
  lu            Boolean          @default(false)
  data          String?          @db.Text
  dateCreation  DateTime         @default(now()) @map("date_creation") @db.Timestamp()

  destinataire  GithubUser       @relation("DestinataireNotif", fields: [idUtilisateur], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ================================
// GitHub OAuth users
// ================================
model GithubUser {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  githubId  String   @unique @map("github_id")
  username  String?  @db.VarChar(150)
  email     String?  @unique @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp()
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamp()

  // Relations
  projets        Projet[]        @relation("ProprietaireProjet")
  diagrammes     Diagramme[]     @relation("ProprietaireDiagramme")
  collaborations Collaboration[] @relation("GithubUserCollaborations")
  demandesAcces  DemandeAcces[]  @relation("Demandeur")
  notifications  Notification[]  @relation("DestinataireNotif")

  @@map("github_users")
}
